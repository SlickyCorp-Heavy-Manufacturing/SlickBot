{
  "$schema": "https://json.schemastore.org/semantic-release.json",
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", {
      "preset": "conventionalcommits",
      "releaseRules": [
        { "type": "build", "release": "patch" },
        { "type": "feature", "release": "minor" }
      ]
    }],
    "@semantic-release/release-notes-generator",
    ["@semantic-release/npm", {
      "npmPublish": false
    }],
    ["@codedependant/semantic-release-docker", {
      "dockerBuildFlags": {
        "annotation": [
          "index:org.opencontainers.image.description=Discord bot that does important features",
          "index:org.opencontainers.image.source=https://github.com/SlickyCorp-Heavy-Manufacturing/SlickBot"
        ]
      },
      "dockerBuildQuiet": false,
      "dockerPlatform": ["linux/amd64", "linux/arm64/v8"],
      "dockerRegistry": "ghcr.io"
    }],
    "@semantic-release/github"
  ]
}
